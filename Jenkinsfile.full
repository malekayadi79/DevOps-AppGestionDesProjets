pipeline {
    agent any

    tools {
        maven 'M2_HOME'
    }

    environment {
        SONAR_PROJECT_KEY = 'appgestiondesprojets'
        DOCKERHUB_USER    = 'malekayedi79'
        BACKEND_IMAGE     = "${DOCKERHUB_USER}/gestion-projets-backend"
        FRONTEND_IMAGE    = "${DOCKERHUB_USER}/gestion-projets-frontend"
        TAG               = "${env.BUILD_NUMBER}"
    }

    stages {

        stage('1. GIT') {
            steps {
                checkout scm
            }
        }

        stage('2. Maven Compile') {
            steps {
                dir('backend') {
                    sh 'mvn clean compile'
                }
            }
        }

        stage('3. SonarQube') {
            steps {
                dir('backend') {
                    withSonarQubeEnv('SonarQubeServer') {
                        sh 'mvn sonar:sonar -Dsonar.projectKey=$SONAR_PROJECT_KEY'
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Start MySQL for tests') {
            steps {
                sh 'docker rm -f mysql-db || true'
                sh 'docker compose up -d mysql'
                sh '''
                    for i in $(seq 1 30); do
                        docker exec mysql-db mysqladmin ping -h localhost -uroot -proot --silent && break
                        echo "Waiting for MySQL..."
                        sleep 2
                    done
                '''
            }
        }

        stage('4. Maven Test') {
            steps {
                dir('backend') {
                    sh 'mvn test'
                }
            }
        }

        stage('5. Maven Package') {
            steps {
                dir('backend') {
                    sh 'mvn package -DskipTests'
                }
            }
        }

        stage('6. Maven Deploy (skip tests)') {
            steps {
                dir('backend') {
                    sh 'mvn install -DskipTests'
                }
            }
        }

        stage('7. Docker Build & Push') {
            steps {
                sh 'docker build -t $BACKEND_IMAGE:$TAG -t $BACKEND_IMAGE:latest ./backend'
                sh 'docker build -t $FRONTEND_IMAGE:$TAG -t $FRONTEND_IMAGE:latest ./frontend'
                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds',
                                                  usernameVariable: 'DH_USER',
                                                  passwordVariable: 'DH_PASS')]) {
                    sh 'echo $DH_PASS | docker login -u $DH_USER --password-stdin'
                    sh 'docker push $BACKEND_IMAGE:$TAG'
                    sh 'docker push $BACKEND_IMAGE:latest'
                    sh 'docker push $FRONTEND_IMAGE:$TAG'
                    sh 'docker push $FRONTEND_IMAGE:latest'
                }
            }
        }

        stage('8. Docker Compose Up') {
            steps {
                sh 'docker rm -f backend-app frontend-app || true'
                sh 'docker compose up -d --build'
                sh 'docker compose ps'
            }
        }
    }

    post {
        always {
            sh 'docker logout || true'
        }
    }
}
